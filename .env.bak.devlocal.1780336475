# research-orchestrator environment configuration.
# Copy to .env and fill in. The service refuses to boot if any required
# field is missing or the shared secret is the dev sentinel on prod.

# ── HTTP surface ───────────────────────────────────────────────────────────
ORCH_HOST=0.0.0.0
ORCH_PORT=8082
ORCH_LOG_LEVEL=INFO

# ── Auth (shared secret) ───────────────────────────────────────────────────
# Caller MUST send this in `X-Orch-Token`. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real secret. The dev sentinel is rejected on prod profile.
ORCH_AUTH_TOKEN=9a510bfa627827b49de61b7317aeafba212321ffe9bf56c4d1df0916b4f5a215
ORCH_PROFILE=dev    # dev|prod — prod refuses dev sentinels

# ── Database ──────────────────────────────────────────────────────────────
# Connect as blackheart_research (V14 role) — orchestrator only needs DML on
# research/backtest tables. Postgres URL form.
ORCH_DB_DSN=postgresql://blackheart_research:CLjj505OEU5emM5aaLCmHJlRrwcx@100.112.13.126:5432/trading_db
ORCH_DB_POOL_MIN=2
ORCH_DB_POOL_MAX=10

# ── JVM (research JVM, port 8081) ─────────────────────────────────────────
# Orchestrator dispatches backtests / sweeps / walk-forwards to the JVM.
# Trading JVM is NOT used directly — research JVM proxies what it needs to.
ORCH_JVM_BASE_URL=http://127.0.0.1:8081
ORCH_JVM_REQUEST_TIMEOUT_S=30

# ── Auth into the JVM ─────────────────────────────────────────────────────
# Three modes: dev_bypass (uses /api/v1/dev/login-as), service_account,
# or static_jwt (pre-minted token when dev-tooling is absent from classpath).
# static_jwt: set ORCH_JVM_STATIC_JWT to a valid Bearer token. Token must
# carry a real userId (8ff655fa-2d13-4c65-98b9-8dd1e37ef23a = rfkih23@gmail.com).
# Workaround for research JVM bootRun mode without dev-tooling classpath.
ORCH_JVM_AUTH_MODE=dev_bypass
ORCH_JVM_DEV_LOGIN_EMAIL=rfkih23@gmail.com
ORCH_JVM_STATIC_JWT=
ORCH_JVM_SERVICE_USER=
ORCH_JVM_SERVICE_PASSWORD=

# ── Telegram alerts (optional — ingest service handles backend alerts) ────
# Orchestrator only alerts on its OWN failures (DB unreachable, JVM down,
# claim-loop crash). Backend errors continue going through DbErrorAppender.
ORCH_TELEGRAM_BOT_TOKEN=8907288018:AAHm0qV29kyn1IzgW6FrXYvLIQTvW0WmDi8
ORCH_TELEGRAM_CHAT_ID=1089479092

# ── Redis pub/sub (optional — real-time activity streaming) ───────────────
# When set, every activity event is also published to the 'research:activity'
# Redis channel. The Trading JVM subscribes and forwards to STOMP WebSocket
# so the frontend /admin/research-activity page shows live updates.
# Leave blank to disable; activity still persists to DB.
ORCH_REDIS_URL=redis://127.0.0.1:6379/0

# ── AI paper narrative ─────────────────────────────────────────────────────
# paper_narrator.py calls the `claude` CLI (Max plan OAuth) as a subprocess.
# Set to 1 to enable; falls back to deterministic template when disabled.
ORCH_AI_NARRATIVE_ENABLED=1
# Override the CLI path if needed:
# CLAUDE_BIN=C:\Users\rifki\AppData\Local\Microsoft\WinGet\Links\claude.exe
